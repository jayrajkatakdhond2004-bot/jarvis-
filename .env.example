# Required: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional but recommended: free key from https://console.picovoice.ai/
# If empty, Jarvis falls back to openWakeWord (say "Hey Jarvis").
PICOVOICE_ACCESS_KEY=

# --- Optional tuning (defaults shown) ---
# JARVIS_MODEL=claude-sonnet-5-5
# JARVIS_EFFORT=low
# WHISPER_MODEL=base.en          # base.en | small.en | small
# TTS_ENGINE=say                 # say | elevenlabs
# TTS_VOICE=Daniel
# TTS_RATE=185
# WAKE_SENSITIVITY=0.6           # 0..1, higher = more triggers
# SILENCE_SECONDS=1.0            # stop recording after this much silence
# MAX_RECORD_SECONDS=15
# JARVIS_CONFIRM_APPLESCRIPT=risky   # risky | always | never

# Only if TTS_ENGINE=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
